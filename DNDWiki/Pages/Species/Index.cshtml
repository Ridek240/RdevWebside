@page
@model DNDWiki.Pages.Species.IndexModel
@{
}
<a class="btn btn-sm btn-primary" href="/DND/Species/AddSpecies">
    Add
</a>
@if (Model.Species == null || !Model.Species.Any())
{
    <p>Brak klas do wyświetlenia.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nazwa klasy</th>
                <th>Źródło</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cls in Model.Species)
            {
                <tr style="cursor:pointer;"
                    onclick="location.href='/DND/Species/SpeciesDetails?Id=@cls.Id'">
                    <td>@cls.Name</td>
                    <td>@cls.Source</td>
                </tr>
            }
        </tbody>
    </table>
}
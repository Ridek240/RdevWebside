@page
@model Main.Pages.Administration.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<h1>Manage Users</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Login</th>
            <th>Email</th>
            <th>Invite Token</th>
            <th>Roles</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            var userRoles = await Model._userManager.GetRolesAsync(user);
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.InviteToken?.Token</td>
                <td>@string.Join(", ", userRoles)</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <select name="roleName">
                            @foreach (var role in Model.Roles)
                            {
                                if (!userRoles.Contains(role))
                                {
                                    <option value="@role">@role</option>
                                }
                            }
                        </select>
                        <button type="submit" asp-page-handler="AddRole" class="btn btn-sm btn-success">Add Role</button>
                    </form>

                    <form method="post" style="display:inline">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <select name="roleName">
                            @foreach (var role in userRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button type="submit" asp-page-handler="RemoveRole" class="btn btn-sm btn-danger">Remove Role</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
